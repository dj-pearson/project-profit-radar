<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	Push notifications ship with the Alerts tab (deliver-apns). Xcode writes
	"production" into this key when it exports for TestFlight / App Store.
	com.apple.developer.location.push stays omitted: there is no background
	location, and declaring unused entitlements invites App Store review
	questions.
	-->
	<key>aps-environment</key>
	<string>development</string>

	<!-- Keychain Access Groups for secure token storage -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.brikly.app</string>
	</array>

	<!-- Associated Domains for universal links and web credentials -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:brikly.net</string>
		<string>applinks:app.brikly.net</string>
		<string>webcredentials:brikly.net</string>
	</array>

	<!-- Sign in with Apple -->
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
</dict>
</plist>
