# Brikly Mobile App Environment Variables
# Copy this file to .env and fill in your actual values

# Supabase Configuration
EXPO_PUBLIC_SUPABASE_URL=your_supabase_project_url
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# App Configuration
EXPO_PUBLIC_APP_NAME=Brikly
EXPO_PUBLIC_APP_VERSION=1.0.0
EXPO_PUBLIC_API_BASE_URL=https://api.brikly.net

# Feature Flags
EXPO_PUBLIC_ENABLE_BIOMETRIC_AUTH=true
EXPO_PUBLIC_ENABLE_OFFLINE_MODE=true
EXPO_PUBLIC_ENABLE_PUSH_NOTIFICATIONS=true
EXPO_PUBLIC_ENABLE_BACKGROUND_SYNC=true
EXPO_PUBLIC_ENABLE_GEOFENCING=true

# Analytics & Monitoring
EXPO_PUBLIC_GOOGLE_ANALYTICS_ID=your_ga_tracking_id
EXPO_PUBLIC_SENTRY_DSN=your_sentry_dsn
EXPO_PUBLIC_MIXPANEL_TOKEN=your_mixpanel_token

# Third-Party Integrations
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key
EXPO_PUBLIC_WEATHER_API_KEY=your_weather_api_key
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key

# Development Settings
EXPO_PUBLIC_DEBUG_MODE=false
EXPO_PUBLIC_LOG_LEVEL=info
EXPO_PUBLIC_MOCK_DATA=false

# Push Notifications
EXPO_PUBLIC_FCM_SENDER_ID=your_fcm_sender_id
EXPO_PUBLIC_VAPID_KEY=your_vapid_key

# Social Authentication (Optional)
EXPO_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id
EXPO_PUBLIC_APPLE_CLIENT_ID=your_apple_client_id
EXPO_PUBLIC_MICROSOFT_CLIENT_ID=your_microsoft_client_id

# ============================================================
# WEB APP (Vite) — set these in the Cloudflare Pages environment
# ============================================================
# Supabase (web)
VITE_SUPABASE_URL=https://api.brikly.net
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_key

# Error tracking (strongly recommended in production — without VITE_SENTRY_DSN
# the web app silently ships with Sentry error tracking DISABLED).
VITE_SENTRY_DSN=your_sentry_dsn
# Release tag for Sentry (e.g. git SHA or package version); enables de-minified
# stack traces when sourcemaps are uploaded. Build with VITE_SOURCEMAP=true to
# emit hidden sourcemaps for the Sentry release upload.
VITE_APP_VERSION=1.0.0

# Product analytics (optional)
VITE_POSTHOG_API_KEY=your_posthog_key
VITE_POSTHOG_HOST=https://us.i.posthog.com
