-- Name: leads Admin and sales can manage leads; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Admin and sales can manage leads" ON public.leads TO authenticated USING ((EXISTS ( SELECT 1
   FROM public.user_profiles
  WHERE ((user_profiles.id = auth.uid()) AND (user_profiles.role = ANY (ARRAY['root_admin'::public.user_role, 'admin'::public.user_role, 'office_staff'::public.user_role]))))));


--
-- Name: leads Admin and sales can view all leads optimized; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Admin and sales can view all leads optimized" ON public.leads FOR SELECT TO authenticated USING (((public.get_user_role(auth.uid()) = ANY (ARRAY['root_admin'::public.user_role, 'admin'::public.user_role, 'office_staff'::public.user_role])) OR (assigned_to = auth.uid())));


--
-- Name: POLICY "Admin and sales can view all leads optimized" ON leads; Type: COMMENT; Schema: public; Owner: postgres
--

COMMENT ON POLICY "Admin and sales can view all leads optimized" ON public.leads IS 'Optimized version using cached role lookup instead of nested EXISTS subquery';


