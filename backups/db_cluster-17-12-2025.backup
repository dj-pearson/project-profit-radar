--
-- Name: booking_pages Public can view active booking pages; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Public can view active booking pages" ON public.booking_pages FOR SELECT USING ((is_active = true));


--
-- Name: sites Public can view active sites; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Public can view active sites" ON public.sites FOR SELECT TO authenticated, anon USING ((is_active = true));


--
-- Name: availability_rules Public can view availability rules for active pages; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Public can view availability rules for active pages" ON public.availability_rules FOR SELECT USING ((EXISTS ( SELECT 1
   FROM public.booking_pages
  WHERE ((booking_pages.id = availability_rules.booking_page_id) AND (booking_pages.is_active = true)))));


