--
-- Name: seo_quality_backlinks; Type: VIEW; Schema: public; Owner: postgres
--

CREATE VIEW public.seo_quality_backlinks AS
 SELECT id,
    company_id,
    source_domain,
    target_url,
    anchor_text,
    link_quality_score,
    source_domain_authority,
    link_type,
    link_status
   FROM public.seo_backlinks bl
  WHERE ((link_quality_score >= 70) AND (link_status = 'active'::text))
  ORDER BY link_quality_score DESC;


ALTER VIEW public.seo_quality_backlinks OWNER TO postgres;

--
-- Name: VIEW seo_quality_backlinks; Type: COMMENT; Schema: public; Owner: postgres
--

COMMENT ON VIEW public.seo_quality_backlinks IS 'High-quality active backlinks';


