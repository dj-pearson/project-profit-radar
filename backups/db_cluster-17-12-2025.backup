--
-- Name: objects Admin delete access for site assets; Type: POLICY; Schema: storage; Owner: supabase_storage_admin
--

CREATE POLICY "Admin delete access for site assets" ON storage.objects FOR DELETE USING (((bucket_id = 'site-assets'::text) AND (auth.uid() IS NOT NULL) AND (EXISTS ( SELECT 1
   FROM public.user_profiles
  WHERE ((user_profiles.id = auth.uid()) AND (user_profiles.role = ANY (ARRAY['root_admin'::public.user_role, 'admin'::public.user_role])))))));


--
-- Name: objects Admin update access for site assets; Type: POLICY; Schema: storage; Owner: supabase_storage_admin
--

CREATE POLICY "Admin update access for site assets" ON storage.objects FOR UPDATE USING (((bucket_id = 'site-assets'::text) AND (auth.uid() IS NOT NULL) AND (EXISTS ( SELECT 1
   FROM public.user_profiles
  WHERE ((user_profiles.id = auth.uid()) AND (user_profiles.role = ANY (ARRAY['root_admin'::public.user_role, 'admin'::public.user_role])))))));


--
-- Name: objects Admin upload access for site assets; Type: POLICY; Schema: storage; Owner: supabase_storage_admin
--

CREATE POLICY "Admin upload access for site assets" ON storage.objects FOR INSERT WITH CHECK (((bucket_id = 'site-assets'::text) AND (auth.uid() IS NOT NULL) AND (EXISTS ( SELECT 1
   FROM public.user_profiles
  WHERE ((user_profiles.id = auth.uid()) AND (user_profiles.role = ANY (ARRAY['root_admin'::public.user_role, 'admin'::public.user_role])))))));


--
-- Name: objects Anyone can view blog images; Type: POLICY; Schema: storage; Owner: supabase_storage_admin
--

CREATE POLICY "Anyone can view blog images" ON storage.objects FOR SELECT USING ((bucket_id = 'blog-images'::text));


--
-- Name: objects Authorized users can delete company documents; Type: POLICY; Schema: storage; Owner: supabase_storage_admin
--

CREATE POLICY "Authorized users can delete company documents" ON storage.objects FOR DELETE USING (((bucket_id = 'company-documents'::text) AND ((storage.foldername(name))[1] = (public.get_user_company(auth.uid()))::text) AND (public.get_user_role(auth.uid()) = ANY (ARRAY['admin'::public.user_role, 'office_staff'::public.user_role, 'root_admin'::public.user_role]))));


--
-- Name: objects Authorized users can delete project documents; Type: POLICY; Schema: storage; Owner: supabase_storage_admin
--

CREATE POLICY "Authorized users can delete project documents" ON storage.objects FOR DELETE USING (((bucket_id = 'project-documents'::text) AND (EXISTS ( SELECT 1
   FROM public.projects p
  WHERE (((p.id)::text = (storage.foldername(p.name))[1]) AND (p.company_id = public.get_user_company(auth.uid())) AND (public.get_user_role(auth.uid()) = ANY (ARRAY['admin'::public.user_role, 'project_manager'::public.user_role, 'office_staff'::public.user_role, 'root_admin'::public.user_role])))))));


--
-- Name: objects Authorized users can update company documents; Type: POLICY; Schema: storage; Owner: supabase_storage_admin
--

CREATE POLICY "Authorized users can update company documents" ON storage.objects FOR UPDATE USING (((bucket_id = 'company-documents'::text) AND ((storage.foldername(name))[1] = (public.get_user_company(auth.uid()))::text) AND (public.get_user_role(auth.uid()) = ANY (ARRAY['admin'::public.user_role, 'office_staff'::public.user_role, 'root_admin'::public.user_role]))));


--
-- Name: objects Authorized users can update project documents; Type: POLICY; Schema: storage; Owner: supabase_storage_admin
--

CREATE POLICY "Authorized users can update project documents" ON storage.objects FOR UPDATE USING (((bucket_id = 'project-documents'::text) AND (EXISTS ( SELECT 1
   FROM public.projects p
  WHERE (((p.id)::text = (storage.foldername(p.name))[1]) AND (p.company_id = public.get_user_company(auth.uid())) AND (public.get_user_role(auth.uid()) = ANY (ARRAY['admin'::public.user_role, 'project_manager'::public.user_role, 'office_staff'::public.user_role, 'root_admin'::public.user_role])))))));


--
-- Name: objects Authorized users can upload company documents; Type: POLICY; Schema: storage; Owner: supabase_storage_admin
--

