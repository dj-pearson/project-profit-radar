CREATE POLICY site_api_keys_update ON public.api_keys FOR UPDATE USING (((site_id = ((((auth.jwt() -> 'app_metadata'::text) -> 'site_id'::text))::text)::uuid) AND (company_id IN ( SELECT user_profiles.company_id
   FROM public.user_profiles
  WHERE ((user_profiles.id = auth.uid()) AND (user_profiles.role = ANY (ARRAY['admin'::public.user_role, 'root_admin'::public.user_role])))))));


