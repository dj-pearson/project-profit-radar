--
-- Name: service_calls; Type: TABLE; Schema: public; Owner: postgres
--

CREATE TABLE public.service_calls (
    id uuid DEFAULT gen_random_uuid() NOT NULL,
    company_id uuid NOT NULL,
    project_id uuid,
    call_number text NOT NULL,
    title text NOT NULL,
    description text,
    customer_name text NOT NULL,
    customer_phone text,
    customer_email text,
    customer_address text NOT NULL,
    customer_contact_person text,
    customer_company text,
    service_type text NOT NULL,
    priority text DEFAULT 'standard'::text NOT NULL,
    trade_required text,
    requested_date date,
    requested_time_start time without time zone,
    requested_time_end time without time zone,
    scheduled_date date,
    scheduled_time_start time without time zone,
    scheduled_time_end time without time zone,
    estimated_duration_minutes integer DEFAULT 60,
    status text DEFAULT 'received'::text NOT NULL,
    completion_status text,
    estimated_cost numeric(10,2) DEFAULT 0,
    actual_cost numeric(10,2) DEFAULT 0,
    parts_cost numeric(10,2) DEFAULT 0,
    labor_cost numeric(10,2) DEFAULT 0,
    travel_cost numeric(10,2) DEFAULT 0,
    is_billable boolean DEFAULT true,
    is_warranty_work boolean DEFAULT false,
    assigned_technician_id uuid,
    backup_technician_id uuid,
    dispatcher_id uuid,
    service_location_lat numeric(10,8),
    service_location_lng numeric(11,8),
    access_instructions text,
    special_requirements text,
    safety_notes text,
    equipment_needed text[],
    tools_required text[],
    parts_needed jsonb DEFAULT '[]'::jsonb,
    work_performed text,
    resolution_notes text,
    customer_satisfaction_rating integer,
    customer_feedback text,
    requires_follow_up boolean DEFAULT false,
    follow_up_date date,
    follow_up_notes text,
    customer_notified boolean DEFAULT false,
    arrival_notification_sent boolean DEFAULT false,
    completion_notification_sent boolean DEFAULT false,
    dispatched_at timestamp with time zone,
    arrived_at timestamp with time zone,
    work_started_at timestamp with time zone,
    work_completed_at timestamp with time zone,
    departed_at timestamp with time zone,
    photos jsonb DEFAULT '[]'::jsonb,
    before_photos jsonb DEFAULT '[]'::jsonb,
    after_photos jsonb DEFAULT '[]'::jsonb,
    work_order_document_path text,
    invoice_document_path text,
    customer_signature_path text,
    weather_conditions text,
    traffic_conditions text,
    technician_notes text,
    internal_notes text,
    is_recurring boolean DEFAULT false,
    recurring_frequency text,
    next_service_date date,
    created_by uuid,
    created_at timestamp with time zone DEFAULT now() NOT NULL,
    updated_at timestamp with time zone DEFAULT now() NOT NULL,
    CONSTRAINT service_calls_completion_status_check CHECK ((completion_status = ANY (ARRAY['completed'::text, 'partially_completed'::text, 'unable_to_complete'::text, 'requires_follow_up'::text]))),
    CONSTRAINT service_calls_customer_satisfaction_rating_check CHECK (((customer_satisfaction_rating >= 1) AND (customer_satisfaction_rating <= 5))),
    CONSTRAINT service_calls_priority_check CHECK ((priority = ANY (ARRAY['emergency'::text, 'urgent'::text, 'standard'::text, 'low'::text]))),
    CONSTRAINT service_calls_recurring_frequency_check CHECK ((recurring_frequency = ANY (ARRAY['weekly'::text, 'monthly'::text, 'quarterly'::text, 'semi_annually'::text, 'annually'::text]))),
    CONSTRAINT service_calls_service_type_check CHECK ((service_type = ANY (ARRAY['repair'::text, 'maintenance'::text, 'inspection'::text, 'emergency'::text, 'installation'::text, 'consultation'::text, 'warranty_work'::text, 'preventive_maintenance'::text, 'other'::text]))),
    CONSTRAINT service_calls_status_check CHECK ((status = ANY (ARRAY['received'::text, 'scheduled'::text, 'dispatched'::text, 'en_route'::text, 'on_site'::text, 'in_progress'::text, 'parts_needed'::text, 'on_hold'::text, 'completed'::text, 'cancelled'::text, 'rescheduled'::text]))),
    CONSTRAINT service_calls_trade_required_check CHECK ((trade_required = ANY (ARRAY['general'::text, 'electrical'::text, 'plumbing'::text, 'hvac'::text, 'roofing'::text, 'flooring'::text, 'painting'::text, 'landscaping'::text, 'other'::text])))
);


ALTER TABLE public.service_calls OWNER TO postgres;

