    work_order_reference text,
    verified_by uuid,
    verified_at timestamp with time zone,
    recorded_by uuid,
    created_at timestamp with time zone DEFAULT now() NOT NULL,
    updated_at timestamp with time zone DEFAULT now() NOT NULL,
    CONSTRAINT equipment_utilization_detailed_activity_type_check CHECK ((activity_type = ANY (ARRAY['excavation'::text, 'hauling'::text, 'grading'::text, 'compaction'::text, 'lifting'::text, 'drilling'::text, 'paving'::text, 'demolition'::text, 'loading'::text, 'transport'::text, 'idle'::text, 'other'::text]))),
    CONSTRAINT equipment_utilization_detailed_terrain_type_check CHECK ((terrain_type = ANY (ARRAY['flat'::text, 'hilly'::text, 'rough'::text, 'paved'::text, 'unpaved'::text, 'wet'::text, 'dry'::text])))
);


ALTER TABLE public.equipment_utilization_detailed OWNER TO postgres;

--
-- Name: equipment_with_qr; Type: VIEW; Schema: public; Owner: postgres
--

CREATE VIEW public.equipment_with_qr AS
 SELECT e.id AS equipment_id,
    e.company_id,
    e.name,
    e.equipment_type,
    e.model,
    e.serial_number,
    e.status,
    e.location,
    qr.id AS qr_code_id,
    qr.qr_code_value,
    qr.qr_code_image,
    qr.generated_at AS qr_generated_at,
    qr.scan_count,
    qr.last_scanned_at,
    qr.is_active AS qr_is_active,
        CASE
            WHEN (qr.id IS NOT NULL) THEN true
            ELSE false
        END AS has_qr_code
   FROM (public.equipment e
     LEFT JOIN public.equipment_qr_codes qr ON (((e.id = qr.equipment_id) AND (qr.is_active = true))));


ALTER VIEW public.equipment_with_qr OWNER TO postgres;

--
-- Name: VIEW equipment_with_qr; Type: COMMENT; Schema: public; Owner: postgres
--

COMMENT ON VIEW public.equipment_with_qr IS 'Equipment records with QR code status and checkout information';


