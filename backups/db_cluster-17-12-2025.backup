  WHERE ((tenant_users.tenant_id = sso_connections.tenant_id) AND (tenant_users.user_id = auth.uid()) AND (tenant_users.role = ANY (ARRAY['owner'::text, 'admin'::text])) AND (tenant_users.is_active = true)))));


