--
-- Name: seo_top_performing_content; Type: VIEW; Schema: public; Owner: postgres
--

CREATE VIEW public.seo_top_performing_content AS
 SELECT url,
    title,
    organic_sessions,
    avg_position,
    total_clicks,
    conversion_rate,
    estimated_value,
    period_start,
    period_end
   FROM public.seo_content_performance cp
  WHERE (period_start >= (CURRENT_DATE - '30 days'::interval))
  ORDER BY organic_sessions DESC
 LIMIT 50;


ALTER VIEW public.seo_top_performing_content OWNER TO postgres;

--
-- Name: VIEW seo_top_performing_content; Type: COMMENT; Schema: public; Owner: postgres
--

COMMENT ON VIEW public.seo_top_performing_content IS 'Top performing content by organic traffic';


--
-- Name: seo_unoptimized_images; Type: VIEW; Schema: public; Owner: postgres
--

CREATE VIEW public.seo_unoptimized_images AS
 SELECT id,
    company_id,
    source_page_url,
    image_url,
    has_alt_text,
    file_size_bytes,
    potential_savings_bytes,
    recommended_format
   FROM public.seo_image_analysis ia
  WHERE ((is_optimized = false) OR (has_alt_text = false))
  ORDER BY potential_savings_bytes DESC;


ALTER VIEW public.seo_unoptimized_images OWNER TO postgres;

