-- Name: geofences Project managers can manage geofences; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Project managers can manage geofences" ON public.geofences USING ((EXISTS ( SELECT 1
   FROM public.user_profiles
  WHERE ((user_profiles.id = auth.uid()) AND (user_profiles.role = ANY (ARRAY['root_admin'::public.user_role, 'admin'::public.user_role, 'project_manager'::public.user_role]))))));


