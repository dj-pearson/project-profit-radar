--
-- Name: top_keywords_performance; Type: VIEW; Schema: public; Owner: postgres
--

CREATE VIEW public.top_keywords_performance AS
 SELECT company_id,
    keyword,
    platform_name,
    sum(impressions) AS total_impressions,
    sum(clicks) AS total_clicks,
    avg(ctr) AS avg_ctr,
    avg("position") AS avg_position
   FROM public.unified_keyword_performance
  WHERE (date >= (CURRENT_DATE - '30 days'::interval))
  GROUP BY company_id, keyword, platform_name
  ORDER BY (sum(clicks)) DESC, (sum(impressions)) DESC;


ALTER VIEW public.top_keywords_performance OWNER TO postgres;

