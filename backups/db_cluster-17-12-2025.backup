    impact_estimate text,
    affected_urls text[],
    affected_keywords text[],
    metrics_data jsonb DEFAULT '{}'::jsonb,
    recommendations jsonb DEFAULT '[]'::jsonb,
    action_items jsonb DEFAULT '[]'::jsonb,
    status text DEFAULT 'active'::text,
