-- Name: scaling_progress; Type: TABLE; Schema: public; Owner: postgres
--

CREATE TABLE public.scaling_progress (
    id uuid DEFAULT gen_random_uuid() NOT NULL,
    company_id uuid NOT NULL,
    scaling_plan_id uuid,
    metric_type text NOT NULL,
    metric_name text NOT NULL,
    baseline_value numeric NOT NULL,
    current_value numeric NOT NULL,
    target_value numeric NOT NULL,
    measurement_unit text NOT NULL,
    measurement_date date DEFAULT CURRENT_DATE NOT NULL,
    progress_percentage numeric GENERATED ALWAYS AS (
CASE
    WHEN (target_value = baseline_value) THEN (100)::numeric
    ELSE LEAST((100)::numeric, GREATEST((0)::numeric, (((current_value - baseline_value) / (target_value - baseline_value)) * (100)::numeric)))
END) STORED,
    notes text,
    data_source text DEFAULT 'manual'::text,
    verified_by uuid,
    created_at timestamp with time zone DEFAULT now() NOT NULL,
    updated_at timestamp with time zone DEFAULT now() NOT NULL,
    CONSTRAINT scaling_progress_metric_type_check CHECK ((metric_type = ANY (ARRAY['revenue'::text, 'team_size'::text, 'project_count'::text, 'customer_count'::text, 'market_share'::text, 'operational_efficiency'::text, 'profit_margin'::text])))
);


ALTER TABLE public.scaling_progress OWNER TO postgres;

