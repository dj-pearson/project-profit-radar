--
-- Name: crew_assignments_pending_checkin; Type: VIEW; Schema: public; Owner: postgres
--

CREATE VIEW public.crew_assignments_pending_checkin AS
 SELECT ca.id,
    ca.crew_member_id,
    ca.project_id,
    ca.assigned_date,
    ca.status,
    concat(up.first_name, ' ', up.last_name) AS crew_member_name,
    p.name AS project_name,
    p.site_address AS project_location,
    g.center_lat AS geofence_latitude,
    g.center_lng AS geofence_longitude,
    g.radius_meters AS geofence_radius_meters
   FROM (((public.crew_assignments ca
     JOIN public.user_profiles up ON ((ca.crew_member_id = up.id)))
     JOIN public.projects p ON ((ca.project_id = p.id)))
     LEFT JOIN public.geofences g ON ((ca.geofence_id = g.id)))
  WHERE ((ca.assigned_date = CURRENT_DATE) AND (ca.status = ANY (ARRAY['scheduled'::text, 'dispatched'::text])) AND (ca.gps_checkin_verified IS NOT TRUE))
  ORDER BY ca.assigned_date, (concat(up.first_name, ' ', up.last_name));


ALTER VIEW public.crew_assignments_pending_checkin OWNER TO postgres;

--
-- Name: VIEW crew_assignments_pending_checkin; Type: COMMENT; Schema: public; Owner: postgres
--

COMMENT ON VIEW public.crew_assignments_pending_checkin IS 'Crew assignments scheduled for today that need GPS check-in';


--
-- Name: crew_presence_dashboard; Type: VIEW; Schema: public; Owner: postgres
--

CREATE VIEW public.crew_presence_dashboard AS
 SELECT ca.id AS assignment_id,
    ca.project_id,
    ca.assigned_date,
    ca.status,
    ca.is_onsite,
    ca.gps_checkin_timestamp,
    ca.gps_checkout_timestamp,
    ca.distance_from_site,
    ca.gps_checkin_verified,
    up.id AS user_id,
    concat(up.first_name, ' ', up.last_name) AS crew_member_name,
    up.email AS crew_member_email,
    up.phone AS crew_member_phone,
    up.role AS crew_member_role,
    p.name AS project_name,
    p.site_address AS project_location,
    g.name AS geofence_name,
    g.geofence_type,
    g.center_lat AS geofence_center_lat,
    g.center_lng AS geofence_center_lng,
    g.radius_meters AS geofence_radius,
        CASE
            WHEN (ca.is_onsite AND (ca.gps_checkin_timestamp IS NOT NULL)) THEN (EXTRACT(epoch FROM (now() - ca.gps_checkin_timestamp)) / (3600)::numeric)
            ELSE (0)::numeric
        END AS hours_onsite,
        CASE
            WHEN ca.is_onsite THEN 'On Site'::text
            WHEN (ca.status = 'dispatched'::text) THEN 'En Route'::text
            WHEN (ca.status = 'scheduled'::text) THEN 'Scheduled'::text
            WHEN (ca.status = 'completed'::text) THEN 'Completed'::text
            ELSE 'Unknown'::text
        END AS presence_status
   FROM (((public.crew_assignments ca
     JOIN public.user_profiles up ON ((ca.crew_member_id = up.id)))
     JOIN public.projects p ON ((ca.project_id = p.id)))
     LEFT JOIN public.geofences g ON ((ca.geofence_id = g.id)))
  WHERE (ca.assigned_date >= (CURRENT_DATE - '7 days'::interval))
  ORDER BY ca.is_onsite DESC, ca.gps_checkin_timestamp DESC;


ALTER VIEW public.crew_presence_dashboard OWNER TO postgres;

--
-- Name: VIEW crew_presence_dashboard; Type: COMMENT; Schema: public; Owner: postgres
--

COMMENT ON VIEW public.crew_presence_dashboard IS 'Real-time dashboard showing current crew presence and location status';


