--
-- Name: generate_secure_api_key(text); Type: FUNCTION; Schema: public; Owner: postgres
--

CREATE FUNCTION public.generate_secure_api_key(p_prefix text DEFAULT 'bdesk'::text) RETURNS TABLE(full_key text, key_prefix text, key_hash text, key_salt text, key_encrypted text)
    LANGUAGE plpgsql SECURITY DEFINER
    AS $$
DECLARE
  v_random_bytes BYTEA;
  v_key_suffix TEXT;
  v_full_key TEXT;
  v_salt TEXT;
  v_hash TEXT;
  v_encrypted TEXT;
  v_encryption_key TEXT;
BEGIN
  -- Generate 32 bytes of random data
  v_random_bytes := gen_random_bytes(32);

  -- Create URL-safe base64 key suffix
  v_key_suffix := replace(replace(encode(v_random_bytes, 'base64'), '/', '_'), '+', '-');
  v_key_suffix := replace(v_key_suffix, '=', '');

  -- Full key format: prefix_suffix
  v_full_key := p_prefix || '_' || v_key_suffix;

  -- Generate unique salt
  v_salt := encode(gen_random_bytes(16), 'hex');

  -- Create HMAC-SHA256 hash with salt
  v_hash := encode(
    hmac(
      v_full_key::bytea,
      v_salt::bytea,
      'sha256'
    ),
    'hex'
  );

  -- Encrypt the key for recoverable storage (admin only)
  v_encryption_key := get_encryption_key('api_key');
  v_encrypted := encode(
    pgp_sym_encrypt(
      v_full_key,
      v_encryption_key,
      'compress-algo=1, cipher-algo=aes256'
    ),
    'base64'
  );

  -- Return all components
  RETURN QUERY SELECT
    v_full_key AS full_key,
    left(v_full_key, 12) AS key_prefix,  -- Show first 12 chars as prefix
    v_hash AS key_hash,
    v_salt AS key_salt,
    v_encrypted AS key_encrypted;
END;
$$;


ALTER FUNCTION public.generate_secure_api_key(p_prefix text) OWNER TO postgres;

--
-- Name: FUNCTION generate_secure_api_key(p_prefix text); Type: COMMENT; Schema: public; Owner: postgres
--

COMMENT ON FUNCTION public.generate_secure_api_key(p_prefix text) IS 'Generates a cryptographically secure API key with HMAC-SHA256 hash and AES-256 encrypted storage';


