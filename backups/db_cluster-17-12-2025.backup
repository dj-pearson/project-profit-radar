    "position" numeric(5,2),
    device_type text,
    country text,
    search_appearance text,
    date date NOT NULL,
    date_range_type text DEFAULT 'daily'::text,
    impressions_previous integer,
    clicks_previous integer,
    ctr_previous numeric(5,2),
    position_previous numeric(5,2),
    impressions_change integer,
    clicks_change integer,
    ctr_change numeric(5,2),
    position_change numeric(5,2),
    created_at timestamp with time zone DEFAULT now() NOT NULL
);


ALTER TABLE public.gsc_keyword_performance OWNER TO postgres;

