-- Name: objects Users can view company documents; Type: POLICY; Schema: storage; Owner: supabase_storage_admin
--

CREATE POLICY "Users can view company documents" ON storage.objects FOR SELECT USING (((bucket_id = 'company-documents'::text) AND ((storage.foldername(name))[1] = (public.get_user_company(auth.uid()))::text)));


--
-- Name: objects Users can view company project documents; Type: POLICY; Schema: storage; Owner: supabase_storage_admin
--

CREATE POLICY "Users can view company project documents" ON storage.objects FOR SELECT USING (((bucket_id = 'project-documents'::text) AND (EXISTS ( SELECT 1
   FROM public.projects p
  WHERE (((p.id)::text = (storage.foldername(p.name))[1]) AND ((p.company_id = public.get_user_company(auth.uid())) OR (public.get_user_role(auth.uid()) = 'root_admin'::public.user_role)))))));


