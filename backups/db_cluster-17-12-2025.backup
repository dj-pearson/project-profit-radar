--

COMMENT ON TABLE public.gsc_page_performance IS 'Page performance data from Google Search Console';


--
-- Name: gsc_page_summary; Type: VIEW; Schema: public; Owner: postgres
--

CREATE VIEW public.gsc_page_summary AS
 SELECT company_id,
    page_url,
    page_type,
    sum(impressions) AS total_impressions,
    sum(clicks) AS total_clicks,
    avg(ctr) AS avg_ctr,
    avg(average_position) AS avg_position,
    count(DISTINCT date) AS days_tracked
   FROM public.gsc_page_performance pp
  WHERE (date >= (CURRENT_DATE - '30 days'::interval))
  GROUP BY company_id, page_url, page_type;


ALTER VIEW public.gsc_page_summary OWNER TO postgres;

--
