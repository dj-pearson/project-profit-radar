);


ALTER TABLE public.daily_reports OWNER TO postgres;

--
-- Name: daily_reports_with_details; Type: VIEW; Schema: public; Owner: postgres
--

CREATE VIEW public.daily_reports_with_details AS
 SELECT dr.id,
    dr.project_id,
    dr.date,
    dr.company_id,
    dr.template_id,
    dr.status,
    dr.completion_percentage,
    dr.weather_conditions,
    dr.temperature,
    dr.work_performed,
    dr.delays_issues,
    dr.safety_incidents,
    dr.next_day_plan,
    dr.quality_issues,
    dr.gps_latitude,
    dr.gps_longitude,
    dr.submitted_by,
    dr.submission_timestamp,
    dr.created_at,
    p.name AS project_name,
    p.site_address AS project_location,
    drt.name AS template_name,
    concat(up.first_name, ' ', up.last_name) AS submitted_by_name,
    ( SELECT count(*) AS count
           FROM public.daily_report_crew_items
          WHERE (daily_report_crew_items.daily_report_id = dr.id)) AS crew_count,
    ( SELECT count(*) AS count
           FROM public.daily_report_task_items
          WHERE (daily_report_task_items.daily_report_id = dr.id)) AS task_count,
    ( SELECT COALESCE(avg(daily_report_task_items.completion_percentage), (0)::numeric) AS "coalesce"
           FROM public.daily_report_task_items
          WHERE (daily_report_task_items.daily_report_id = dr.id)) AS avg_task_completion
   FROM (((public.daily_reports dr
     LEFT JOIN public.projects p ON ((dr.project_id = p.id)))
     LEFT JOIN public.daily_report_templates drt ON ((dr.template_id = drt.id)))
     LEFT JOIN public.user_profiles up ON ((dr.submitted_by = up.id)));


ALTER VIEW public.daily_reports_with_details OWNER TO postgres;

--
-- Name: VIEW daily_reports_with_details; Type: COMMENT; Schema: public; Owner: postgres
--

COMMENT ON VIEW public.daily_reports_with_details IS 'Complete daily report data with joined project, template, and statistics';


--
-- Name: unified_traffic_metrics; Type: TABLE; Schema: public; Owner: postgres
--

CREATE TABLE public.unified_traffic_metrics (
    id uuid DEFAULT gen_random_uuid() NOT NULL,
    company_id uuid,
    date date NOT NULL,
    date_range_type text DEFAULT 'daily'::text,
    platform_name text NOT NULL,
    property_id text,
    sessions integer DEFAULT 0,
    users integer DEFAULT 0,
    new_users integer DEFAULT 0,
    pageviews integer DEFAULT 0,
    bounce_rate numeric(5,2),
    avg_session_duration integer,
    impressions integer DEFAULT 0,
    clicks integer DEFAULT 0,
    ctr numeric(5,2),
    average_position numeric(5,2),
    engagement_rate numeric(5,2),
    engaged_sessions integer DEFAULT 0,
    events_count integer DEFAULT 0,
    conversions integer DEFAULT 0,
    conversion_rate numeric(5,2),
    goal_completions integer DEFAULT 0,
    organic_traffic integer DEFAULT 0,
    direct_traffic integer DEFAULT 0,
    referral_traffic integer DEFAULT 0,
    social_traffic integer DEFAULT 0,
    paid_traffic integer DEFAULT 0,
    email_traffic integer DEFAULT 0,
    desktop_sessions integer DEFAULT 0,
    mobile_sessions integer DEFAULT 0,
    tablet_sessions integer DEFAULT 0,
    top_country text,
    top_city text,
    raw_data jsonb DEFAULT '{}'::jsonb,
    created_at timestamp with time zone DEFAULT now() NOT NULL
);


ALTER TABLE public.unified_traffic_metrics OWNER TO postgres;

--
-- Name: TABLE unified_traffic_metrics; Type: COMMENT; Schema: public; Owner: postgres
--

COMMENT ON TABLE public.unified_traffic_metrics IS 'Unified daily traffic metrics from all platforms';


--
-- Name: daily_traffic_overview; Type: VIEW; Schema: public; Owner: postgres
--

CREATE VIEW public.daily_traffic_overview AS
 SELECT company_id,
    date,
    sum(sessions) AS total_sessions,
    sum(users) AS total_users,
    sum(pageviews) AS total_pageviews,
    sum(impressions) AS total_impressions,
    sum(clicks) AS total_clicks,
    avg(ctr) AS avg_ctr,
    avg(average_position) AS avg_position,
    sum(conversions) AS total_conversions
   FROM public.unified_traffic_metrics
  WHERE (platform_name <> 'aggregated'::text)
  GROUP BY company_id, date;


ALTER VIEW public.daily_traffic_overview OWNER TO postgres;

