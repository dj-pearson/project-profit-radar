    updated_at timestamp with time zone DEFAULT now() NOT NULL,
    template_id uuid,
    probability_weight integer DEFAULT 50,
    is_final_stage boolean DEFAULT false,
    is_won_stage boolean DEFAULT false,
    is_lost_stage boolean DEFAULT false,
    auto_tasks jsonb DEFAULT '[]'::jsonb,
    required_fields jsonb DEFAULT '[]'::jsonb,
    expected_duration_days integer,
    conversion_rate numeric(5,2),
    CONSTRAINT pipeline_stages_probability_percent_check CHECK (((probability_percent >= 0) AND (probability_percent <= 100)))
);


ALTER TABLE public.pipeline_stages OWNER TO postgres;

