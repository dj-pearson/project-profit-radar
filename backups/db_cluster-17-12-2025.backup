--
-- Name: seo_mobile_unfriendly_pages; Type: VIEW; Schema: public; Owner: postgres
--

CREATE VIEW public.seo_mobile_unfriendly_pages AS
 SELECT id,
    company_id,
    url,
    mobile_friendly_score,
    mobile_issues,
    recommendations
   FROM public.seo_mobile_analysis ma
  WHERE ((is_mobile_friendly = false) OR (mobile_friendly_score < 70))
  ORDER BY mobile_friendly_score;


