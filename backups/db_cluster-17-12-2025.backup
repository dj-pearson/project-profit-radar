    id uuid DEFAULT gen_random_uuid() NOT NULL,
    company_id uuid NOT NULL,
    project_id uuid,
    vendor_id uuid,
    warranty_type text NOT NULL,
    item_name text NOT NULL,
    item_description text,
    manufacturer text,
    model_number text,
    serial_number text,
    purchase_order_id uuid,
    warranty_duration_months integer NOT NULL,
    warranty_start_date date DEFAULT CURRENT_DATE NOT NULL,
    warranty_end_date date,
    coverage_details text,
    coverage_limitations text,
    is_transferable boolean DEFAULT false NOT NULL,
    is_transferred_to_customer boolean DEFAULT false NOT NULL,
    transferred_at timestamp with time zone,
    transferred_by uuid,
    warranty_contact_name text,
    warranty_contact_phone text,
    warranty_contact_email text,
    warranty_document_path text,
    installation_date date,
    status text DEFAULT 'active'::text NOT NULL,
    notes text,
    created_by uuid,
    created_at timestamp with time zone DEFAULT now() NOT NULL,
    updated_at timestamp with time zone DEFAULT now() NOT NULL,
    CONSTRAINT warranties_status_check CHECK ((status = ANY (ARRAY['active'::text, 'expired'::text, 'claimed'::text, 'voided'::text, 'transferred'::text]))),
    CONSTRAINT warranties_warranty_type_check CHECK ((warranty_type = ANY (ARRAY['material'::text, 'equipment'::text, 'labor'::text, 'system'::text, 'manufacturer'::text])))
);


