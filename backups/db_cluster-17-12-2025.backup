-- Name: user_profiles user_profiles_insert_with_site; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY user_profiles_insert_with_site ON public.user_profiles FOR INSERT TO authenticated WITH CHECK (((((auth.jwt() -> 'app_metadata'::text) ->> 'site_id'::text) IS NOT NULL) AND (site_id = (((auth.jwt() -> 'app_metadata'::text) ->> 'site_id'::text))::uuid) AND (id = auth.uid())));


--
-- Name: user_profiles user_profiles_site_isolation; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY user_profiles_site_isolation ON public.user_profiles FOR SELECT TO authenticated USING ((((((auth.jwt() -> 'app_metadata'::text) ->> 'site_id'::text) IS NOT NULL) AND (site_id = (((auth.jwt() -> 'app_metadata'::text) ->> 'site_id'::text))::uuid)) OR (id = auth.uid())));


--
-- Name: user_profiles user_profiles_update_own; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY user_profiles_update_own ON public.user_profiles FOR UPDATE TO authenticated USING ((id = auth.uid()));


