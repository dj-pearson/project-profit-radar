    CONSTRAINT account_health_scores_project_activity_score_check CHECK (((project_activity_score >= 0) AND (project_activity_score <= 100))),
    CONSTRAINT account_health_scores_risk_level_check CHECK ((risk_level = ANY (ARRAY['low'::text, 'medium'::text, 'high'::text, 'critical'::text]))),
    CONSTRAINT account_health_scores_score_check CHECK (((score >= 0) AND (score <= 100))),
    CONSTRAINT account_health_scores_support_score_check CHECK (((support_score >= 0) AND (support_score <= 100))),
    CONSTRAINT account_health_scores_team_engagement_score_check CHECK (((team_engagement_score >= 0) AND (team_engagement_score <= 100))),
    CONSTRAINT account_health_scores_trend_check CHECK ((trend = ANY (ARRAY['up'::text, 'down'::text, 'stable'::text])))
);


ALTER TABLE public.account_health_scores OWNER TO postgres;

