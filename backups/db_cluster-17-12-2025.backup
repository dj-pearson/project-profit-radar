-- Name: calculate_retention_days(); Type: FUNCTION; Schema: public; Owner: postgres
--

CREATE FUNCTION public.calculate_retention_days() RETURNS trigger
    LANGUAGE plpgsql
    AS $$
BEGIN
  NEW.retention_period_days := EXTRACT(EPOCH FROM NEW.retention_period)::INTEGER / 86400;
  NEW.next_application_at := NOW() + INTERVAL '1 day';
  RETURN NEW;
END;
$$;


