CREATE POLICY "Users can view tenant settings" ON public.tenant_settings FOR SELECT USING ((((is_public = true) AND (EXISTS ( SELECT 1
   FROM public.tenant_users
  WHERE ((tenant_users.tenant_id = tenant_settings.tenant_id) AND (tenant_users.user_id = auth.uid()) AND (tenant_users.is_active = true))))) OR (EXISTS ( SELECT 1
   FROM public.tenant_users
  WHERE ((tenant_users.tenant_id = tenant_settings.tenant_id) AND (tenant_users.user_id = auth.uid()) AND (tenant_users.role = ANY (ARRAY['owner'::text, 'admin'::text])) AND (tenant_users.is_active = true))))));


