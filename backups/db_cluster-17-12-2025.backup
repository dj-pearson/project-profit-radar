--
-- Name: system_admin_settings; Type: TABLE; Schema: public; Owner: postgres
--

CREATE TABLE public.system_admin_settings (
    id uuid DEFAULT gen_random_uuid() NOT NULL,
    email_templates jsonb DEFAULT '{"welcome": {"enabled": true, "subject": "Welcome to {{company_name}}", "template": "<h1>Welcome {{user_name}}</h1><p>Welcome to our platform.</p>"}, "invoice_due": {"enabled": true, "subject": "Invoice {{invoice_number}} Due", "template": "<h1>Payment Due</h1><p>Invoice {{invoice_number}} for {{amount}} is due on {{due_date}}.</p>"}, "safety_incident": {"enabled": true, "subject": "Safety Incident Report - {{project_name}}", "template": "<h1>Safety Incident</h1><p>A safety incident has been reported on project {{project_name}}.</p>"}, "project_completion": {"enabled": true, "subject": "Project {{project_name}} Completed", "template": "<h1>Project Completed</h1><p>Project {{project_name}} has been marked as completed.</p>"}}'::jsonb,
    form_templates jsonb DEFAULT '{"rfi_form": {"name": "Request for Information", "fields": [{"type": "text", "label": "RFI Number", "required": true}, {"type": "text", "label": "Requested By", "required": true}, {"type": "textarea", "label": "Question/Request", "required": true}, {"type": "date", "label": "Response Needed By", "required": true}], "enabled": true}, "inspection_form": {"name": "Site Inspection", "fields": [{"type": "text", "label": "Inspector Name", "required": true}, {"type": "date", "label": "Inspection Date", "required": true}, {"type": "select", "label": "Overall Status", "options": ["Pass", "Fail", "Conditional"], "required": true}, {"type": "textarea", "label": "Notes", "required": false}], "enabled": true}, "change_order_form": {"name": "Change Order Request", "fields": [{"type": "text", "label": "Change Order Number", "required": true}, {"type": "number", "label": "Cost Impact", "required": true}, {"type": "number", "label": "Schedule Impact (Days)", "required": false}, {"type": "textarea", "label": "Description of Change", "required": true}], "enabled": true}}'::jsonb,
    report_templates jsonb DEFAULT '{"safety_report": {"kpis": [{"label": "Incident Rate", "format": "rate", "metric": "incident_rate"}, {"label": "Days Without Incident", "format": "number", "metric": "days_without_incident"}, {"label": "Training Completion", "format": "percentage", "metric": "safety_training_completion"}, {"label": "Compliance Score", "format": "percentage", "metric": "compliance_score"}], "name": "Safety Report", "charts": ["incident_trend", "training_status", "compliance_overview"], "enabled": true}, "financial_summary": {"kpis": [{"label": "Total Revenue", "format": "currency", "metric": "total_revenue"}, {"label": "Total Costs", "format": "currency", "metric": "total_costs"}, {"label": "Profit Margin", "format": "percentage", "metric": "profit_margin"}, {"label": "Outstanding Invoices", "format": "currency", "metric": "outstanding_invoices"}], "name": "Financial Summary", "charts": ["revenue_trend", "cost_breakdown", "profit_analysis"], "enabled": true}, "project_dashboard": {"kpis": [{"label": "Completion %", "format": "percentage", "metric": "completion_percentage"}, {"label": "Budget Variance", "format": "currency", "metric": "budget_variance"}, {"label": "Schedule Variance", "format": "days", "metric": "schedule_variance"}, {"label": "Safety Incidents", "format": "number", "metric": "safety_incidents"}], "name": "Project Dashboard", "charts": ["timeline", "budget_breakdown", "resource_allocation"], "enabled": true}}'::jsonb,
    document_management jsonb DEFAULT '{"version_control": {"enabled": true, "max_versions": 10, "auto_archive_old_versions": true}, "folder_structure": {"hr": {"subfolders": ["employee_records", "training", "safety", "payroll"], "naming_convention": "{{employee_id}}_{{document_type}}_{{date}}"}, "company": {"subfolders": ["policies", "templates", "certifications", "insurance"], "naming_convention": "{{category}}_{{document_name}}_{{version}}"}, "projects": {"subfolders": ["contracts", "drawings", "photos", "reports", "correspondence"], "naming_convention": "{{project_number}}_{{document_type}}_{{date}}"}}, "approval_workflows": {"invoice_approval": {"steps": [{"role": "accounting", "action": "review"}, {"role": "admin", "action": "approve"}], "enabled": true}, "contract_approval": {"steps": [{"role": "project_manager", "action": "review"}, {"role": "admin", "action": "approve"}, {"role": "client", "action": "sign"}], "enabled": true}, "safety_document_approval": {"steps": [{"role": "safety_officer", "action": "review"}, {"role": "superintendent", "action": "approve"}], "enabled": true}}, "retention_policies": {"safety_records": {"years": 5, "archive_after_completion": false}, "employee_records": {"years": 7, "archive_after_termination": true}, "financial_records": {"years": 10, "archive_after_completion": false}, "project_documents": {"years": 7, "archive_after_completion": true}}}'::jsonb,
    system_preferences jsonb DEFAULT '{"date_format": "MM/DD/YYYY", "number_format": "en-US", "platform_name": "Construction Manager Pro", "backup_frequency": "daily", "default_currency": "USD", "default_timezone": "America/New_York", "max_file_size_mb": 100, "allowed_file_types": [".pdf", ".docx", ".xlsx", ".jpg", ".png", ".dwg"], "data_retention_days": 2555}'::jsonb,
    created_at timestamp with time zone DEFAULT now() NOT NULL,
    updated_at timestamp with time zone DEFAULT now() NOT NULL,
    created_by uuid,
    updated_by uuid
);


ALTER TABLE public.system_admin_settings OWNER TO postgres;

