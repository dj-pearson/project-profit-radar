    detected_at timestamp with time zone DEFAULT now() NOT NULL,
    acknowledged_at timestamp with time zone,
    resolved_at timestamp with time zone,
    acknowledged_by uuid,
    resolved_by uuid,
    notes text,
    created_at timestamp with time zone DEFAULT now() NOT NULL,
    updated_at timestamp with time zone DEFAULT now() NOT NULL,
    site_id uuid NOT NULL
);


ALTER TABLE public.seo_insights OWNER TO postgres;

--
-- Name: TABLE seo_insights; Type: COMMENT; Schema: public; Owner: postgres
--

COMMENT ON TABLE public.seo_insights IS 'AI-powered SEO insights and recommendations';


--
-- Name: active_seo_insights_summary; Type: VIEW; Schema: public; Owner: postgres
--

CREATE VIEW public.active_seo_insights_summary AS
 SELECT company_id,
    insight_type,
    category,
    severity,
    count(*) AS insight_count,
    avg(priority) AS avg_priority
   FROM public.seo_insights
  WHERE (status = ANY (ARRAY['active'::text, 'in_progress'::text]))
  GROUP BY company_id, insight_type, category, severity;


ALTER VIEW public.active_seo_insights_summary OWNER TO postgres;

