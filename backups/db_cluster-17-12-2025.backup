    updated_at timestamp with time zone DEFAULT now() NOT NULL,
    site_id uuid,
    credentials_encrypted_v2 text
);


ALTER TABLE public.integration_configurations OWNER TO postgres;

--
-- Name: integration_configurations_secure; Type: VIEW; Schema: public; Owner: postgres
--

CREATE VIEW public.integration_configurations_secure AS
 SELECT id,
    company_id,
    site_id,
    integration_type,
    integration_name,
    configuration,
        CASE
            WHEN (EXISTS ( SELECT 1
               FROM public.user_profiles
              WHERE ((user_profiles.id = auth.uid()) AND (user_profiles.role = ANY (ARRAY['admin'::public.user_role, 'root_admin'::public.user_role]))))) THEN public.decrypt_sensitive(credentials_encrypted_v2, 'integration_credentials'::text)
            ELSE NULL::text
        END AS credentials,
    is_active,
    created_at
   FROM public.integration_configurations
  WHERE (site_id = ((((auth.jwt() -> 'app_metadata'::text) -> 'site_id'::text))::text)::uuid);


ALTER VIEW public.integration_configurations_secure OWNER TO postgres;

