    keyword_in_meta_description boolean DEFAULT false,
    keyword_in_url boolean DEFAULT false,
    keyword_in_first_paragraph boolean DEFAULT false,
    flesch_reading_ease numeric(5,2),
    flesch_kincaid_grade numeric(5,2),
    gunning_fog_index numeric(5,2),
    smog_index numeric(5,2),
    heading_count jsonb DEFAULT '{"h1": 0, "h2": 0, "h3": 0, "h4": 0, "h5": 0, "h6": 0}'::jsonb,
    has_table_of_contents boolean DEFAULT false,
    has_images boolean DEFAULT false,
    images_with_alt_count integer DEFAULT 0,
    has_videos boolean DEFAULT false,
    has_infographics boolean DEFAULT false,
    title_length integer,
    title_optimal boolean DEFAULT false,
    meta_description_length integer,
    meta_description_optimal boolean DEFAULT false,
    has_focus_keyphrase_in_seo_title boolean DEFAULT false,
    unique_content_percentage numeric(5,2),
    thin_content boolean DEFAULT false,
    duplicate_content_issues integer DEFAULT 0,
    estimated_reading_time integer,
    content_depth_score integer,
    recommendations jsonb DEFAULT '[]'::jsonb,
    priority_actions text[],
    ai_optimized boolean DEFAULT false,
    ai_optimization_suggestions jsonb DEFAULT '[]'::jsonb,
    ai_generated_meta_title text,
    ai_generated_meta_description text,
    optimization_status text DEFAULT 'pending'::text,
    last_optimized_at timestamp with time zone,
    optimized_by uuid,
    analyzed_at timestamp with time zone DEFAULT now() NOT NULL,
    created_at timestamp with time zone DEFAULT now() NOT NULL,
    updated_at timestamp with time zone DEFAULT now() NOT NULL,
    site_id uuid NOT NULL
);


ALTER TABLE public.seo_content_optimization OWNER TO postgres;

--
-- Name: TABLE seo_content_optimization; Type: COMMENT; Schema: public; Owner: postgres
--

COMMENT ON TABLE public.seo_content_optimization IS 'Content optimization analysis and scores';


--
-- Name: seo_content_needs_optimization; Type: VIEW; Schema: public; Owner: postgres
--

CREATE VIEW public.seo_content_needs_optimization AS
 SELECT id,
    company_id,
    url,
    page_title,
    primary_keyword,
    overall_seo_score,
    optimization_status,
    priority_actions
   FROM public.seo_content_optimization co
  WHERE ((overall_seo_score < 70) OR (optimization_status = ANY (ARRAY['pending'::text, 'needs_review'::text])))
  ORDER BY overall_seo_score;


ALTER VIEW public.seo_content_needs_optimization OWNER TO postgres;

