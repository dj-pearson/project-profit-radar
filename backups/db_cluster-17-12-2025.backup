--
-- Name: companies Allow viewing companies in site; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Allow viewing companies in site" ON public.companies FOR SELECT TO authenticated USING (((site_id = public.current_site_id()) OR (site_id IN ( SELECT sites.id
   FROM public.sites
  WHERE (sites.is_active = true))) OR (id IN ( SELECT user_profiles.company_id
   FROM public.user_profiles
  WHERE (user_profiles.id = auth.uid()))) OR (EXISTS ( SELECT 1
