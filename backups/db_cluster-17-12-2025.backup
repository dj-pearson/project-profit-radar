--
-- Name: api_keys site_api_keys_delete; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY site_api_keys_delete ON public.api_keys FOR DELETE USING (((site_id = ((((auth.jwt() -> 'app_metadata'::text) -> 'site_id'::text))::text)::uuid) AND (company_id IN ( SELECT user_profiles.company_id
   FROM public.user_profiles
  WHERE ((user_profiles.id = auth.uid()) AND (user_profiles.role = ANY (ARRAY['admin'::public.user_role, 'root_admin'::public.user_role])))))));


--
-- Name: api_keys site_api_keys_insert; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY site_api_keys_insert ON public.api_keys FOR INSERT WITH CHECK (((site_id = ((((auth.jwt() -> 'app_metadata'::text) -> 'site_id'::text))::text)::uuid) AND (company_id IN ( SELECT user_profiles.company_id
   FROM public.user_profiles
  WHERE ((user_profiles.id = auth.uid()) AND (user_profiles.role = ANY (ARRAY['admin'::public.user_role, 'root_admin'::public.user_role])))))));


--
-- Name: api_keys site_api_keys_select; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY site_api_keys_select ON public.api_keys FOR SELECT USING (((site_id = ((((auth.jwt() -> 'app_metadata'::text) -> 'site_id'::text))::text)::uuid) AND ((company_id IN ( SELECT user_profiles.company_id
   FROM public.user_profiles
  WHERE ((user_profiles.id = auth.uid()) AND (user_profiles.role = ANY (ARRAY['admin'::public.user_role, 'root_admin'::public.user_role]))))) OR (EXISTS ( SELECT 1
   FROM public.user_profiles
  WHERE ((user_profiles.id = auth.uid()) AND (user_profiles.role = 'root_admin'::public.user_role)))))));


--
-- Name: api_keys site_api_keys_update; Type: POLICY; Schema: public; Owner: postgres
