-- Name: TABLE seo_redirect_analysis; Type: COMMENT; Schema: public; Owner: postgres
--

COMMENT ON TABLE public.seo_redirect_analysis IS 'Analysis of redirects, chains, and loops';


--
-- Name: seo_redirect_chains; Type: VIEW; Schema: public; Owner: postgres
--

CREATE VIEW public.seo_redirect_chains AS
 SELECT id,
    company_id,
    source_url,
    destination_url,
    chain_length,
    redirect_type,
    issue_description,
    priority
   FROM public.seo_redirect_analysis ra
  WHERE (chain_length > 1)
  ORDER BY chain_length DESC, priority DESC;


ALTER VIEW public.seo_redirect_chains OWNER TO postgres;

--
-- Name: VIEW seo_redirect_chains; Type: COMMENT; Schema: public; Owner: postgres
