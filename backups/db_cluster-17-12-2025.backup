--

CREATE FUNCTION public.get_user_tenant(p_user_id uuid) RETURNS uuid
    LANGUAGE plpgsql SECURITY DEFINER
    AS $$
DECLARE
  v_tenant_id UUID;
BEGIN
  SELECT tenant_id INTO v_tenant_id
  FROM tenant_users
  WHERE user_id = p_user_id
  AND is_active = TRUE
  ORDER BY joined_at DESC
  LIMIT 1;

  RETURN v_tenant_id;
END;
$$;


