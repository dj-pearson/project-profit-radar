--
-- Name: todays_scheduled_tasks; Type: VIEW; Schema: public; Owner: postgres
--

CREATE VIEW public.todays_scheduled_tasks AS
 SELECT t.id AS task_id,
    t.project_id,
    t.name AS task_name,
    t.description AS task_description,
    t.status,
    t.completion_percentage,
    t.due_date,
    p.name AS project_name
   FROM (public.tasks t
     JOIN public.projects p ON ((t.project_id = p.id)))
  WHERE ((t.due_date = CURRENT_DATE) AND (t.status = ANY (ARRAY['pending'::text, 'in_progress'::text])))
  ORDER BY t.project_id, t.name;


ALTER VIEW public.todays_scheduled_tasks OWNER TO postgres;

--
-- Name: VIEW todays_scheduled_tasks; Type: COMMENT; Schema: public; Owner: postgres
--

COMMENT ON VIEW public.todays_scheduled_tasks IS 'Tasks scheduled for today across all projects for auto-population';


