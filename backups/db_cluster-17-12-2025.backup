    calculated_at timestamp with time zone DEFAULT now(),
    created_at timestamp with time zone DEFAULT now(),
    CONSTRAINT account_health_scores_feature_adoption_score_check CHECK (((feature_adoption_score >= 0) AND (feature_adoption_score <= 100))),
    CONSTRAINT account_health_scores_login_frequency_score_check CHECK (((login_frequency_score >= 0) AND (login_frequency_score <= 100))),
