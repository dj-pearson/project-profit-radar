-- Name: TABLE gsc_keyword_performance; Type: COMMENT; Schema: public; Owner: postgres
--

COMMENT ON TABLE public.gsc_keyword_performance IS 'Keyword performance data from Google Search Console';


--
-- Name: gsc_keyword_trends; Type: VIEW; Schema: public; Owner: postgres
--

CREATE VIEW public.gsc_keyword_trends AS
 SELECT company_id,
    query,
    date,
    impressions,
    clicks,
    ctr,
    "position",
    device_type,
    lag("position") OVER (PARTITION BY property_id, query ORDER BY date) AS previous_position,
    ("position" - lag("position") OVER (PARTITION BY property_id, query ORDER BY date)) AS position_change
   FROM public.gsc_keyword_performance kp
  WHERE (date >= (CURRENT_DATE - '90 days'::interval));


ALTER VIEW public.gsc_keyword_trends OWNER TO postgres;

--
-- Name: VIEW gsc_keyword_trends; Type: COMMENT; Schema: public; Owner: postgres
--

COMMENT ON VIEW public.gsc_keyword_trends IS 'Keyword ranking trends over time';


