    CONSTRAINT equipment_scan_events_scan_type_check CHECK ((scan_type = ANY (ARRAY['check_out'::text, 'check_in'::text, 'inspection'::text, 'location_update'::text, 'maintenance'::text, 'verification'::text])))
);


