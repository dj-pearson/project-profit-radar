--
-- Name: seo_content_brief_pipeline; Type: VIEW; Schema: public; Owner: postgres
--

CREATE VIEW public.seo_content_brief_pipeline AS
 SELECT id,
    company_id,
    brief_title,
    target_keyword,
    content_type,
    status,
    assigned_to,
    due_date,
        CASE
            WHEN (due_date < CURRENT_DATE) THEN 'overdue'::text
            WHEN (due_date = CURRENT_DATE) THEN 'due_today'::text
            WHEN (due_date <= (CURRENT_DATE + '7 days'::interval)) THEN 'due_soon'::text
            ELSE 'on_track'::text
        END AS urgency,
    created_at
   FROM public.seo_content_briefs cb
  WHERE (status = ANY (ARRAY['draft'::text, 'review'::text, 'approved'::text, 'in_production'::text]))
  ORDER BY due_date;


ALTER VIEW public.seo_content_brief_pipeline OWNER TO postgres;

--
-- Name: VIEW seo_content_brief_pipeline; Type: COMMENT; Schema: public; Owner: postgres
--

COMMENT ON VIEW public.seo_content_brief_pipeline IS 'Content brief pipeline with urgency status';


