--
-- Name: webhook_endpoints_secure; Type: VIEW; Schema: public; Owner: postgres
--

CREATE VIEW public.webhook_endpoints_secure AS
 SELECT id,
    site_id,
    url,
        CASE
            WHEN (EXISTS ( SELECT 1
               FROM public.user_profiles
              WHERE ((user_profiles.id = auth.uid()) AND (user_profiles.role = ANY (ARRAY['admin'::public.user_role, 'root_admin'::public.user_role]))))) THEN public.decrypt_sensitive(secret_encrypted, 'webhook_secret'::text)
            ELSE '********'::text
        END AS secret_token,
    is_active,
    created_at
   FROM public.webhook_endpoints
  WHERE (site_id = ((((auth.jwt() -> 'app_metadata'::text) -> 'site_id'::text))::text)::uuid);


ALTER VIEW public.webhook_endpoints_secure OWNER TO postgres;

