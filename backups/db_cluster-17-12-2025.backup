-- Name: environmental_assessments; Type: TABLE; Schema: public; Owner: postgres
--

CREATE TABLE public.environmental_assessments (
    id uuid DEFAULT gen_random_uuid() NOT NULL,
    permit_id uuid NOT NULL,
    company_id uuid NOT NULL,
    project_id uuid,
    assessment_type text NOT NULL,
    lead_agency text NOT NULL,
    cooperating_agencies text[],
    nepa_process_stage text DEFAULT 'initiation'::text,
    scoping_period_start date,
    scoping_period_end date,
    air_quality_impact text,
    water_quality_impact text,
    soil_impact text,
    vegetation_impact text,
    wildlife_impact text,
    cultural_resources_impact text,
    socioeconomic_impact text,
    noise_impact text,
    visual_impact text,
    cumulative_impact text,
    purpose_and_need text,
    alternatives_considered jsonb DEFAULT '[]'::jsonb,
    preferred_alternative text,
    no_action_alternative text,
    mitigation_measures jsonb DEFAULT '[]'::jsonb,
    monitoring_commitments jsonb DEFAULT '[]'::jsonb,
    adaptive_management_plan text,
    stakeholder_engagement_plan text,
    public_meetings_held jsonb DEFAULT '[]'::jsonb,
    comments_received integer DEFAULT 0,
    comment_response_document_path text,
    assessment_document_path text,
    supporting_studies jsonb DEFAULT '[]'::jsonb,
    gis_data_path text,
    photos_path text,
    finding text,
    decision_rationale text,
    decision_date date,
    post_decision_monitoring text,
    adaptive_management_triggers jsonb DEFAULT '[]'::jsonb,
    prepared_by uuid,
    reviewed_by uuid,
    approved_by uuid,
    created_at timestamp with time zone DEFAULT now() NOT NULL,
    updated_at timestamp with time zone DEFAULT now() NOT NULL,
    CONSTRAINT environmental_assessments_assessment_type_check CHECK ((assessment_type = ANY (ARRAY['environmental_assessment'::text, 'environmental_impact_statement'::text, 'categorical_exclusion'::text, 'supplemental_analysis'::text]))),
    CONSTRAINT environmental_assessments_finding_check CHECK ((finding = ANY (ARRAY['finding_of_no_significant_impact'::text, 'significant_impact_requires_eis'::text, 'pending'::text, 'not_applicable'::text]))),
    CONSTRAINT environmental_assessments_nepa_process_stage_check CHECK ((nepa_process_stage = ANY (ARRAY['initiation'::text, 'scoping'::text, 'analysis'::text, 'draft_document'::text, 'public_review'::text, 'final_document'::text, 'record_of_decision'::text, 'monitoring'::text])))
);


