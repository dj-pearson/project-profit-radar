--
-- Name: encryption_keys encryption_keys_root_admin_only; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY encryption_keys_root_admin_only ON public.encryption_keys USING ((EXISTS ( SELECT 1
   FROM public.user_profiles
  WHERE ((user_profiles.id = auth.uid()) AND (user_profiles.role = 'root_admin'::public.user_role)))));


