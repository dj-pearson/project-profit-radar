--
-- Name: cwv_trends; Type: VIEW; Schema: public; Owner: postgres
--

CREATE VIEW public.cwv_trends AS
 SELECT url,
    device_type,
    date_trunc('day'::text, checked_at) AS check_date,
    avg(lcp) AS avg_lcp,
    avg(fid) AS avg_fid,
    avg(cls) AS avg_cls,
    avg(performance_score) AS avg_performance_score
   FROM public.seo_core_web_vitals
  WHERE (checked_at >= (CURRENT_DATE - '30 days'::interval))
  GROUP BY url, device_type, (date_trunc('day'::text, checked_at))
  ORDER BY (date_trunc('day'::text, checked_at)) DESC;


