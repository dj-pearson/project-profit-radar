--

COMMENT ON COLUMN public.time_entries.approval_notes IS 'Notes added by approver';


--
-- Name: approved_timesheets; Type: VIEW; Schema: public; Owner: postgres
--

CREATE VIEW public.approved_timesheets AS
 SELECT te.id,
    te.user_id,
    te.project_id,
    te.start_time,
    te.end_time,
    te.total_hours,
    te.break_duration,
    te.description,
    te.location,
    te.approval_status,
    te.approved_by,
    te.approved_at,
    te.approval_notes,
    concat(up.first_name, ' ', up.last_name) AS worker_name,
    up.email AS worker_email,
    concat(approver.first_name, ' ', approver.last_name) AS approver_name,
    p.name AS project_name,
    cc.code AS cost_code
   FROM ((((public.time_entries te
     LEFT JOIN public.user_profiles up ON ((te.user_id = up.id)))
     LEFT JOIN public.user_profiles approver ON ((te.approved_by = approver.id)))
     LEFT JOIN public.projects p ON ((te.project_id = p.id)))
     LEFT JOIN public.cost_codes cc ON ((te.cost_code_id = cc.id)))
  WHERE (te.approval_status = 'approved'::text)
  ORDER BY te.approved_at DESC;


ALTER VIEW public.approved_timesheets OWNER TO postgres;

