--
-- Name: agency_coordination Staff can manage agency coordination; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Staff can manage agency coordination" ON public.agency_coordination USING (((company_id = public.get_user_company(auth.uid())) AND (public.get_user_role(auth.uid()) = ANY (ARRAY['admin'::public.user_role, 'project_manager'::public.user_role, 'office_staff'::public.user_role, 'root_admin'::public.user_role]))));


--
-- Name: bid_documents Staff can manage bid documents; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Staff can manage bid documents" ON public.bid_documents USING (((((bid_submission_id IS NOT NULL) AND (EXISTS ( SELECT 1
   FROM public.bid_submissions bs
  WHERE ((bs.id = bid_documents.bid_submission_id) AND (bs.company_id = public.get_user_company(auth.uid())))))) OR ((opportunity_id IS NOT NULL) AND (EXISTS ( SELECT 1
   FROM public.procurement_opportunities po
  WHERE ((po.id = bid_documents.opportunity_id) AND (po.company_id = public.get_user_company(auth.uid()))))))) AND (public.get_user_role(auth.uid()) = ANY (ARRAY['admin'::public.user_role, 'project_manager'::public.user_role, 'office_staff'::public.user_role, 'root_admin'::public.user_role]))));


