-- Name: COLUMN equipment_scan_events.scan_type; Type: COMMENT; Schema: public; Owner: postgres
--

COMMENT ON COLUMN public.equipment_scan_events.scan_type IS 'Type of scan: check_out, check_in, inspection, location_update, maintenance, verification';


--
-- Name: COLUMN equipment_scan_events.overdue_flag; Type: COMMENT; Schema: public; Owner: postgres
--

COMMENT ON COLUMN public.equipment_scan_events.overdue_flag IS 'Set to true if equipment not returned by due date';


--
-- Name: equipment_scan_analytics; Type: VIEW; Schema: public; Owner: postgres
--

CREATE VIEW public.equipment_scan_analytics AS
 SELECT e.id AS equipment_id,
    e.name AS equipment_name,
    e.equipment_type,
    count(ese.id) AS total_scans,
    count(ese.id) FILTER (WHERE (ese.scan_type = 'check_out'::text)) AS check_out_count,
    count(ese.id) FILTER (WHERE (ese.scan_type = 'check_in'::text)) AS check_in_count,
    count(ese.id) FILTER (WHERE (ese.scan_type = 'inspection'::text)) AS inspection_count,
    max(ese.scanned_at) AS last_scanned_at,
    avg(
        CASE ese.condition_rating
            WHEN 'excellent'::text THEN 5
            WHEN 'good'::text THEN 4
            WHEN 'fair'::text THEN 3
            WHEN 'poor'::text THEN 2
            WHEN 'needs_repair'::text THEN 1
            ELSE NULL::integer
        END) AS average_condition_score,
    ( SELECT equipment_scan_events.condition_rating
           FROM public.equipment_scan_events
          WHERE ((equipment_scan_events.equipment_id = e.id) AND (equipment_scan_events.condition_rating IS NOT NULL))
          ORDER BY equipment_scan_events.scanned_at DESC
         LIMIT 1) AS latest_condition,
    count(DISTINCT ese.scanned_by) AS unique_users,
        CASE
            WHEN (qr.id IS NOT NULL) THEN true
            ELSE false
        END AS has_qr_code
   FROM ((public.equipment e
     LEFT JOIN public.equipment_scan_events ese ON ((e.id = ese.equipment_id)))
     LEFT JOIN public.equipment_qr_codes qr ON (((e.id = qr.equipment_id) AND (qr.is_active = true))))
  GROUP BY e.id, e.name, e.equipment_type, qr.id;


ALTER VIEW public.equipment_scan_analytics OWNER TO postgres;

--
-- Name: VIEW equipment_scan_analytics; Type: COMMENT; Schema: public; Owner: postgres
--

COMMENT ON VIEW public.equipment_scan_analytics IS 'Aggregated scan statistics per equipment with condition tracking';


