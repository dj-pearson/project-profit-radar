--
-- Name: seo_alerts_dashboard; Type: VIEW; Schema: public; Owner: postgres
--

CREATE VIEW public.seo_alerts_dashboard AS
 SELECT a.id,
    a.company_id,
    a.alert_type,
    a.severity,
    a.title,
    a.message,
    a.affected_url,
    a.affected_keyword,
    a.status,
    a.created_at,
    (EXTRACT(epoch FROM (now() - a.created_at)) / (3600)::numeric) AS hours_open,
    ar.rule_name
   FROM (public.seo_alerts a
     LEFT JOIN public.seo_alert_rules ar ON ((a.alert_rule_id = ar.id)))
  WHERE (a.status = ANY (ARRAY['open'::text, 'acknowledged'::text]))
  ORDER BY
        CASE a.severity
            WHEN 'critical'::text THEN 1
            WHEN 'high'::text THEN 2
            WHEN 'medium'::text THEN 3
            WHEN 'low'::text THEN 4
            ELSE NULL::integer
        END, a.created_at DESC;


ALTER VIEW public.seo_alerts_dashboard OWNER TO postgres;

--
-- Name: VIEW seo_alerts_dashboard; Type: COMMENT; Schema: public; Owner: postgres
--

COMMENT ON VIEW public.seo_alerts_dashboard IS 'Dashboard view of open SEO alerts';


