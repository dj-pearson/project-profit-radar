--
-- Name: environmental_permits; Type: TABLE; Schema: public; Owner: postgres
--

CREATE TABLE public.environmental_permits (
    id uuid DEFAULT gen_random_uuid() NOT NULL,
    company_id uuid NOT NULL,
    project_id uuid,
    permit_number text NOT NULL,
    permit_name text NOT NULL,
    permit_type text NOT NULL,
    issuing_agency text NOT NULL,
    agency_contact_name text,
    agency_contact_email text,
    agency_contact_phone text,
    description text,
    regulatory_framework text,
    permit_conditions jsonb DEFAULT '[]'::jsonb,
    monitoring_requirements jsonb DEFAULT '[]'::jsonb,
    reporting_requirements jsonb DEFAULT '[]'::jsonb,
    nepa_category text,
    nepa_document_type text,
    nepa_class_of_action text,
    status text DEFAULT 'pending'::text NOT NULL,
    application_date date,
    review_start_date date,
    target_decision_date date,
    decision_date date,
    effective_date date,
    expiration_date date,
    application_fee numeric(10,2) DEFAULT 0,
    annual_fee numeric(10,2) DEFAULT 0,
    compliance_bond_amount numeric(12,2) DEFAULT 0,
    application_document_path text,
    permit_document_path text,
    supporting_documents jsonb DEFAULT '[]'::jsonb,
    last_inspection_date date,
    next_inspection_date date,
    compliance_status text DEFAULT 'compliant'::text,
    violations jsonb DEFAULT '[]'::jsonb,
    renewal_required boolean DEFAULT false,
    renewal_notice_date date,
    renewal_application_deadline date,
    public_comment_period_start date,
    public_comment_period_end date,
    public_hearing_scheduled boolean DEFAULT false,
    public_hearing_date date,
    environmental_impact_summary text,
    mitigation_measures jsonb DEFAULT '[]'::jsonb,
    monitoring_plan text,
    tribal_consultation_required boolean DEFAULT false,
    tribal_consultation_status text,
    interagency_coordination jsonb DEFAULT '[]'::jsonb,
    assigned_to uuid,
    priority text DEFAULT 'medium'::text,
    internal_notes text,
    created_by uuid,
    created_at timestamp with time zone DEFAULT now() NOT NULL,
    updated_at timestamp with time zone DEFAULT now() NOT NULL,
    CONSTRAINT environmental_permits_compliance_status_check CHECK ((compliance_status = ANY (ARRAY['compliant'::text, 'minor_violation'::text, 'major_violation'::text, 'pending_review'::text, 'unknown'::text]))),
    CONSTRAINT environmental_permits_issuing_agency_check CHECK ((issuing_agency = ANY (ARRAY['epa'::text, 'state_epa'::text, 'army_corps'::text, 'usfws'::text, 'noaa'::text, 'state_wildlife'::text, 'local_authority'::text, 'tribal_authority'::text, 'other'::text]))),
    CONSTRAINT environmental_permits_nepa_category_check CHECK ((nepa_category = ANY (ARRAY['categorical_exclusion'::text, 'environmental_assessment'::text, 'environmental_impact_statement'::text, 'not_applicable'::text]))),
    CONSTRAINT environmental_permits_permit_type_check CHECK ((permit_type = ANY (ARRAY['air_quality'::text, 'water_discharge'::text, 'storm_water'::text, 'wetlands'::text, 'endangered_species'::text, 'cultural_resources'::text, 'noise'::text, 'waste_management'::text, 'hazardous_materials'::text, 'nepa_assessment'::text, 'other'::text]))),
    CONSTRAINT environmental_permits_priority_check CHECK ((priority = ANY (ARRAY['low'::text, 'medium'::text, 'high'::text, 'critical'::text]))),
    CONSTRAINT environmental_permits_status_check CHECK ((status = ANY (ARRAY['pending'::text, 'under_review'::text, 'approved'::text, 'conditional_approval'::text, 'denied'::text, 'expired'::text, 'suspended'::text, 'renewed'::text])))
);


