-- Name: cleanup_expired_oauth_states(); Type: FUNCTION; Schema: public; Owner: postgres
--

CREATE FUNCTION public.cleanup_expired_oauth_states() RETURNS trigger
    LANGUAGE plpgsql
    AS $$
BEGIN
  DELETE FROM oauth_pending_states WHERE expires_at < NOW();
  RETURN NEW;
END;
$$;


